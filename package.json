{
  "name": "trio-interview",
  "version": "0.1.0",
  "description": "Browser based live coding interviews with an AI assistant",
  "type": "module",
  "engines": {
    "node": "25.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "check-node-version": "node scripts/check-node-version.js",
    "preinstall": "node scripts/check-node-version.js",
    "dev": "node scripts/check-node-version.js && concurrently \"npm run dev:next\" \"npm run dev:server\"",
    "dev:next": "NODE_OPTIONS='--no-experimental-webstorage' next dev -H 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "next build && tsc --project tsconfig.server.json",
    "start": "node dist/server/index.js",
    "start:next": "NODE_OPTIONS='--no-experimental-webstorage' next start -H 127.0.0.1",
    "interview": "node scripts/preflight.mjs && NODE_OPTIONS='--no-experimental-webstorage' node scripts/check-node-version.js && NODE_OPTIONS='--no-experimental-webstorage' tsx cli/index.ts",
    "interview:prod": "npm run build && NODE_OPTIONS='--no-experimental-webstorage' tsx cli/index.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc --project tsconfig.server.json --noEmit --noUnusedLocals --noUnusedParameters",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.10.0",
    "better-sse": "^0.16.1",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "fastify": "^5.8.2",
    "inquirer": "^13.3.2",
    "nanoid": "^5.1.7",
    "next": "15.5.24",
    "node-pty": "^1.1.0",
    "ora": "^9.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.3",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.1",
    "uuid": "^13.0.0",
    "ws": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "marked": "^14.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "license": "AGPL-3.0-only",
  "author": "guicheffer"
}
